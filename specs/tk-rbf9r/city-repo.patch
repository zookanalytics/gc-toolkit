 #    --base-path sees the full prefix (see tailscale_serve_https in lib/common.sh).
 tailscale_serve_https 7681 /terminal
 
-# 5. Verify.
+# 6. Verify.
 sleep 1
 api_url="https://${tailnet_host}"
 term_code="$(curl -s -o /dev/null -w '%{http_code}' "${api_url}/terminal/" || true)"
