#!/usr/bin/env bash
# Keep generated/seed-audit/ in step with the fragments it renders.
#
# WHY A HOOK AND NOT ONLY A CHECK. generated/seed-audit/ is a golden file over
# every agent prompt and formula recipe in this pack, so it moves whenever a
# fragment moves. A check alone would turn every fragment edit into "your change is fine,
# now go run a command and amend" — which is how golden files acquire a
# reputation for being a tax. Regenerating here means the artifact is simply
# never out of date, and doctor/check-seed-audit-current only ever fires on a
# commit that bypassed hooks (a GitHub web edit, `--no-verify`, an agent with
# core.hooksPath unset).
#
# COST. A commit that touches none of the inputs below pays one `git diff
# --cached --name-only` and exits — single-digit milliseconds. Only a commit
# that actually moves a prompt pays the render (~15-25s, 44 `gc` invocations).
#
# INSTALL. This directory is not wired up by cloning; point git at it once:
#
#     assets/scripts/render-seed-audit.sh --install-hook
#
# which sets `core.hooksPath = assets/hooks`. The path is relative, so it
# resolves in linked worktrees too. `gc doctor` reports when it is not set.
#
# THE ONE SHARP EDGE. The render reads the WORKING TREE, not the index. Under a
# partial `git add -p` of a fragment, the artifact this hook stages describes the
# working tree rather than the commit, and the two reconcile on the next commit.
# The hook says so out loud rather than doing it quietly; it does not stash to
# "fix" it, because the stash stack is shared with every other worktree of this
# repo and popping somebody else's entry is a worse failure than a transient
# artifact.

set -uo pipefail

# Inputs the rendered artifact is a function of. Kept in step with
# digest_inputs() in assets/scripts/render-seed-audit.sh — over-inclusive on
# both sides, since a spurious re-render costs seconds and a missed one ships a
# stale audit.
#
# The renderer is on the list because it CARRIES the synthetic city the prompts
# render against: one line of that scenario moves 13 agent prompts. Omitting it
# let a renderer-only edit stale the artifact while the doctor check still
# reported it current (tk-wchab, pre-open signoff P1).
INPUT_RE='^(agents/|template-fragments/|formulas/|packs/|pack\.toml$|assets/scripts/render-seed-audit\.sh$)'

staged="$(git diff --cached --name-only --diff-filter=ACMRD 2>/dev/null)"
[ -n "$staged" ] || exit 0

touched="$(grep -E "$INPUT_RE" <<< "$staged")"
[ -n "$touched" ] || exit 0

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
script="$root/assets/scripts/render-seed-audit.sh"
# Absent is "this pack has no renderer" — nothing to do. NOT executable is a
# different thing entirely, and testing -x for both let a committed `chmod -x`
# disable the upkeep loop silently while the doctor check also reported OK
# (pre-open signoff P1). Every invocation below therefore goes through `bash`,
# so a mode bit cannot decide whether a seed change regenerates the artifact.
[ -f "$script" ] || exit 0
if [ ! -x "$script" ]; then
    printf 'pre-commit: NOTE — %s is not executable; running it through bash.\n' \
        "assets/scripts/render-seed-audit.sh" >&2
    printf 'pre-commit: restore it with: chmod +x assets/scripts/render-seed-audit.sh\n' >&2
fi

if ! command -v gc >/dev/null 2>&1; then
    printf 'pre-commit: seed audit NOT regenerated — gc is not on PATH.\n' >&2
    printf 'pre-commit: %s input file(s) changed; run the render on a host with gc:\n' \
        "$(printf '%s\n' "$touched" | wc -l | tr -d ' ')" >&2
    printf 'pre-commit:   assets/scripts/render-seed-audit.sh && git add generated/seed-audit\n' >&2
    exit 0
fi

# Warn when the render will see something the commit does not.
dirty="$(git diff --name-only --diff-filter=ACMRD 2>/dev/null | grep -E "$INPUT_RE")"
if [ -n "$dirty" ]; then
    printf 'pre-commit: NOTE — these seed inputs have unstaged changes, so the\n' >&2
    printf 'pre-commit: regenerated audit describes your working tree, not this commit:\n' >&2
    while IFS= read -r f; do printf 'pre-commit:   %s\n' "$f" >&2; done <<< "$dirty"
fi

printf 'pre-commit: seed inputs changed — regenerating generated/seed-audit ...\n' >&2
if ! bash "$script" >&2; then
    printf 'pre-commit: render FAILED. Commit aborted so a broken audit is not committed.\n' >&2
    printf 'pre-commit: re-run it directly to see why: assets/scripts/render-seed-audit.sh\n' >&2
    exit 1
fi

git add "$root/generated/seed-audit" || {
    printf 'pre-commit: could not stage generated/seed-audit\n' >&2
    exit 1
}
printf 'pre-commit: generated/seed-audit regenerated and staged.\n' >&2
exit 0
