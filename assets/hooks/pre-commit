#!/usr/bin/env bash
# Two jobs, in this order.
#
# Refuse a binary file under a docs/ directory. The staged paths go through
# tools/lint-learned.d/docs-binary.sh, the detector tools/lint-learned.sh also
# runs, so the commit fails here and the file never reaches a PR. Like the
# render below, it reads each path's working-tree copy.
#
# Keep generated/seed-audit/ in step with the fragments it renders: a commit
# touching a seed input regenerates the audit and stages it. A commit touching
# no input pays one `git diff --cached --name-only`; one that does pays the
# render (~15-25s).
# This is branch-local upkeep, not a guarantee. The artifact is a function of
# the whole source tree, so a branch stays current only against its own base:
# a commit that bypasses hooks, a host with no `gc` (which exits 0 below), and
# a rebase that replays commits without running hooks all leave a render that
# a later merge lands over inputs it never saw. `merge.sh` is what refuses that
# merge; doctor/check-seed-audit-current reports it in a checkout.
# Install once: assets/scripts/render-seed-audit.sh --install-hook
# (sets core.hooksPath = assets/hooks; relative, so worktrees resolve too).
# Sharp edge: the render reads the WORKING TREE, not the index — under a
# partial `git add -p` the staged artifact describes the working tree, said
# out loud below rather than "fixed" with a shared-stash pop.

set -uo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

# A detector that is gone was retired, so there is nothing to enforce. Once it
# runs, any exit but 0 aborts the commit: 1 is a finding, and anything else
# means the check could not run, which must not read as a pass.
guard="$root/tools/lint-learned.d/docs-binary.sh"
if [ -f "$guard" ]; then
    paths=()
    while IFS= read -r -d '' p; do
        paths+=("$p")
    done < <(git diff --cached --name-only -z --diff-filter=ACMR 2>/dev/null)
    if [ "${#paths[@]}" -gt 0 ]; then
        found="$(cd "$root" 2>/dev/null || exit 2; bash "$guard" "${paths[@]}" </dev/null)"
        rc=$?
        if [ "$rc" -ne 0 ]; then
            [ -n "$found" ] && printf '%s\n' "$found" >&2
            if [ "$rc" -eq 1 ]; then
                printf 'pre-commit: commit refused: a binary file is staged under a docs/ directory.\n' >&2
                printf 'pre-commit: move it under specs/<bead-id>/, or attach it to the PR with assets/scripts/demo-deliver.sh, then commit again.\n' >&2
            else
                printf 'pre-commit: the docs-binary check could not run (exit %s), so the commit is aborted.\n' "$rc" >&2
                printf 'pre-commit: run it directly to see why: tools/lint-learned.d/docs-binary.sh <staged paths>\n' >&2
            fi
            exit 1
        fi
    fi
fi

# Inputs the artifact is a function of — kept in step with digest_inputs()
# in render-seed-audit.sh. The renderer itself is on the list: it CARRIES
# the synthetic city the prompts render against (tk-wchab).
INPUT_RE='^(agents/|template-fragments/|formulas/|packs/|pack\.toml$|assets/scripts/render-seed-audit\.sh$)'

staged="$(git diff --cached --name-only --diff-filter=ACMRD 2>/dev/null)"
[ -n "$staged" ] || exit 0

touched="$(grep -E "$INPUT_RE" <<< "$staged")"
[ -n "$touched" ] || exit 0

script="$root/assets/scripts/render-seed-audit.sh"
# Absent = no renderer, nothing to do; NOT executable is different — every
# invocation goes through bash so a mode bit cannot disable the upkeep loop.
[ -f "$script" ] || exit 0
if [ ! -x "$script" ]; then
    printf 'pre-commit: NOTE — %s is not executable; running it through bash.\n' \
        "assets/scripts/render-seed-audit.sh" >&2
    printf 'pre-commit: restore it with: chmod +x assets/scripts/render-seed-audit.sh\n' >&2
fi

if ! command -v gc >/dev/null 2>&1; then
    printf 'pre-commit: seed audit NOT regenerated — gc is not on PATH.\n' >&2
    printf 'pre-commit: %s input file(s) changed; run the render on a host with gc:\n' \
        "$(printf '%s\n' "$touched" | wc -l | tr -d ' ')" >&2
    printf 'pre-commit:   assets/scripts/render-seed-audit.sh && git add generated/seed-audit\n' >&2
    exit 0
fi

# Warn when the render will see something the commit does not.
dirty="$(git diff --name-only --diff-filter=ACMRD 2>/dev/null | grep -E "$INPUT_RE")"
if [ -n "$dirty" ]; then
    printf 'pre-commit: NOTE — these seed inputs have unstaged changes, so the\n' >&2
    printf 'pre-commit: regenerated audit describes your working tree, not this commit:\n' >&2
    while IFS= read -r f; do printf 'pre-commit:   %s\n' "$f" >&2; done <<< "$dirty"
fi

printf 'pre-commit: seed inputs changed — regenerating generated/seed-audit ...\n' >&2
if ! bash "$script" >&2; then
    printf 'pre-commit: render FAILED. Commit aborted so a broken audit is not committed.\n' >&2
    printf 'pre-commit: re-run it directly to see why: assets/scripts/render-seed-audit.sh\n' >&2
    exit 1
fi

git add "$root/generated/seed-audit" || {
    printf 'pre-commit: could not stage generated/seed-audit\n' >&2
    exit 1
}
printf 'pre-commit: generated/seed-audit regenerated and staged.\n' >&2
exit 0
