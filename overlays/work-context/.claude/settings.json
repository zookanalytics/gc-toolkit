{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "export PATH=\"$HOME/go/bin:$HOME/.local/bin:$PATH\"; S=\"${GC_DIR:-${CLAUDE_PROJECT_DIR:-.}}/.claude/hooks/work-context.sh\"; [ -f \"$S\" ] && sh \"$S\" || true",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "export PATH=\"$HOME/go/bin:$HOME/.local/bin:$PATH\"; for C in \"${GC_RIG_ROOT:-}\" \"${GC_CITY_PATH:-}/rigs/gc-toolkit\"; do S=\"$C/assets/scripts/gh-origin-guard.sh\"; [ -x \"$S\" ] && exec sh \"$S\"; done; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
